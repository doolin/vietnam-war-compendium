# frozen_string_literal: true

require "rake"

LAMBDA_FUNCTION = "this-day-in-vietnam-war"
S3_BUCKET = "this-day-in-vietnam-war-deployments"
BACKUP_BUCKET = "inventium-backups"
BACKUP_REGION = "us-east-1"
S3_KEY = "this-day-deploy.zip"
AWS_REGION = "us-west-1"
CF_DISTRIBUTION = "ERIW60YQ29CKU"
CF_INVALIDATION_PATH = "/this-day-in-vietnam*"
BUILD_DIR = "/tmp/this-day-build"
DEPLOY_ZIP = "/tmp/this-day-deploy.zip"
DOCKER_IMAGE = "public.ecr.aws/sam/build-ruby3.3:latest-x86_64"
BACKUP_PREFIX = "this-day/backups"
DB_PATH = File.expand_path("db/this_day.sqlite3", __dir__)

namespace :db do
  desc "Build the SQLite3 database from YAML event files"
  task :build do
    ruby "db/seed.rb"
  end

  desc "Build a test database with sample events"
  task :build_test do
    require "sqlite3"
    require "fileutils"

    db_path = File.expand_path("db/test.sqlite3", __dir__)
    schema_path = File.expand_path("db/schema.sql", __dir__)
    FileUtils.rm_f(db_path)

    db = SQLite3::Database.new(db_path)
    db.execute_batch(File.read(schema_path))

    db.execute(
      "INSERT INTO events (month, day, year, title, body, photo_url, photo_alt) VALUES (?, ?, ?, ?, ?, ?, ?)",
      [3, 11, 1965, "Operation Rolling Thunder begins",
       "<p>The United States launched Operation Rolling Thunder, a sustained aerial bombing campaign against North Vietnam. The campaign would continue, with occasional pauses, until November 1968.</p>",
       nil, nil]
    )
    event_id = db.last_insert_row_id
    db.execute(
      'INSERT INTO "references" (event_id, position, label, url) VALUES (?, ?, ?, ?)',
      [event_id, 1, "The Pentagon Papers, Chapter IV.C.3", "https://www.archives.gov/research/pentagon-papers"]
    )
    db.execute(
      'INSERT INTO "references" (event_id, position, label, url) VALUES (?, ?, ?, ?)',
      [event_id, 2, "USAF Historical Division monograph", "https://media.defense.gov/2010/Sep/28/2001329801/-1/-1/0/AFD-100928-054.pdf"]
    )

    db.close
    puts "Built test database at #{db_path}"
  end

  desc "Backup SQLite database to S3 (gzipped SQL dump)"
  task :backup do
    require_relative "lib/this_day/backup/s3_backup"

    backup = ThisDay::Backup::S3Backup.new(
      db_path: DB_PATH, bucket: BACKUP_BUCKET,
      region: BACKUP_REGION, prefix: BACKUP_PREFIX
    )
    result = backup.call

    puts "Backup uploaded to s3://#{BACKUP_BUCKET}/#{result[:s3_key]}"
    puts "SHA-256: #{result[:backup_checksum]}"
  end

  desc "Restore SQLite database from S3 backup (optional S3_KEY=... for specific backup)"
  task :restore do
    require_relative "lib/this_day/backup/s3_restore"

    restore = ThisDay::Backup::S3Restore.new(
      bucket: BACKUP_BUCKET, region: BACKUP_REGION, prefix: BACKUP_PREFIX
    )

    key = ENV["S3_KEY"] || restore.latest_key
    raise "No backups found under s3://#{BACKUP_BUCKET}/#{BACKUP_PREFIX}" unless key

    restore.call(s3_key: key, target_db_path: DB_PATH)
    puts "Restored #{DB_PATH} from s3://#{BACKUP_BUCKET}/#{key}"
  end

  desc "Backup round-trip test: backup → upload → download → restore → checksum verify"
  task :backup_round_trip do
    require_relative "lib/this_day/backup/round_trip"

    round_trip = ThisDay::Backup::RoundTrip.new(
      db_path: DB_PATH, bucket: BACKUP_BUCKET,
      region: BACKUP_REGION, prefix: BACKUP_PREFIX
    )
    evidence = round_trip.call

    evidence[:steps].each do |step|
      puts "  #{step[:name]}: #{step[:result]}"
    end
    puts "Round-trip test: #{evidence[:status]}"
  end
end

EVENTS_DIR = File.expand_path("data/events", __dir__)
ARCHIVE_PREFIX = "this-day/references"

namespace :refs do
  def archive_components
    require_relative "lib/this_day/archive/archiver"
    require_relative "lib/this_day/archive/audit"
    # ARCHIVE_INDEX=tmp/x.yaml (passed after the task name) writes to a
    # separate index, so parallel archive runs do not overwrite each
    # other's entries; merge with refs:merge.
    index = ThisDay::Archive::Index.new(*[ENV["ARCHIVE_INDEX"]].compact)
    audit = ThisDay::Archive::Audit.new(index: index, events_dir: EVENTS_DIR)
    [index, audit]
  end

  desc "Fetch, cache, upload, and index every unarchived reference URL, falling back to the latest " \
       "Wayback Machine capture (URL=... for one; NO_S3=1 to skip upload; NO_WAYBACK=1 for live only)"
  task :archive do
    index, audit = archive_components
    s3 = if ENV["NO_S3"]
           nil
         else
           require "aws-sdk-s3"
           Aws::S3::Client.new(region: BACKUP_REGION)
         end
    # One fetcher for both, so the per-host delay covers web.archive.org too.
    fetcher = ThisDay::Archive::Fetcher.new
    wayback = ENV["NO_WAYBACK"] ? nil : ThisDay::Archive::Wayback.new(fetcher: fetcher)
    archiver = ThisDay::Archive::Archiver.new(index: index, fetcher: fetcher, wayback: wayback,
                                              bucket: BACKUP_BUCKET, prefix: ARCHIVE_PREFIX, s3_client: s3)
    urls = ENV["URL"] ? [ENV["URL"]] : audit.unarchived_urls
    puts "Archiving #{urls.size} URL(s)"
    urls.each_with_index do |url, i|
      entry = archiver.archive(url)
      via = entry["via"] ? " (#{entry['via']}, live #{entry['live_status']})" : ""
      puts format("%3d/%d %-9s %s%s", i + 1, urls.size, entry["status"], url, via)
      index.save
    end
    puts "Index: #{index.size} entries at #{index.path}"
  end

  desc "Merge separate archive indexes into the committed one (FILES=a.yaml,b.yaml); " \
       "a newer fetch wins, but a failure never replaces an archived copy"
  task :merge do
    require_relative "lib/this_day/archive/index"
    index = ThisDay::Archive::Index.new
    ENV.fetch("FILES").split(",").each do |path|
      ThisDay::Archive::Index.new(path).entries.each do |entry|
        current = index[entry["url"]]
        next if current && current["fetched_at"].to_s > entry["fetched_at"].to_s
        next if current && current["status"] == "ok" && entry["status"] != "ok"

        index.upsert(entry)
      end
    end
    index.save
    puts "Index: #{index.size} entries at #{index.path}"
  end

  desc "Report references that are missing, failed, or whose page title contradicts the label"
  task :audit do
    _index, audit = archive_components
    s = audit.summary
    puts "References: #{s[:references]}  unique URLs: #{s[:unique_urls]}  archived: #{s[:archived]}"
    puts "Missing: #{s[:missing]}  Failed: #{s[:failed]}  Title mismatch: #{s[:mismatch]}"
    audit.findings.group_by(&:kind).each do |kind, findings|
      puts "\n== #{kind} (#{findings.size})"
      findings.each do |f|
        puts "#{f.file} | #{f.title}\n    #{f.label}\n    #{f.url}\n    #{f.detail}"
      end
    end
  end
end

namespace :provision do
  # Fetching and writing are separate steps. This task does every fetch
  # for a month in one process (polite, Wayback fallback, one index), so
  # the writers need only read files: no shell, no web.
  desc "Archive the cited sources of a month's candidates and write a brief with readable text (MONTH=12)"
  task :fetch do
    require "json"
    require_relative "lib/this_day/archive/archiver"
    require_relative "lib/this_day/archive/text"
    require "aws-sdk-s3"

    month = Integer(ENV.fetch("MONTH"))
    dir = File.expand_path("tmp/provision-#{month}", __dir__)
    candidates_path = File.join(dir, "candidates.json")
    ruby File.expand_path("../research/wikipedia-year-pages/select.rb", __dir__), month.to_s, candidates_path
    days = JSON.parse(File.read(candidates_path))["days"]

    index = ThisDay::Archive::Index.new
    fetcher = ThisDay::Archive::Fetcher.new
    archiver = ThisDay::Archive::Archiver.new(
      index: index, fetcher: fetcher, wayback: ThisDay::Archive::Wayback.new(fetcher: fetcher),
      bucket: BACKUP_BUCKET, prefix: ARCHIVE_PREFIX, s3_client: Aws::S3::Client.new(region: BACKUP_REGION)
    )

    cands = days.flat_map { |d| d["candidates"] }
    urls = (cands.map { |c| c["permalink"] } +
            cands.flat_map { |c| c["refs"].map { |r| r["url"] } }.grep(%r{\Ahttps?://})).uniq
    todo = urls.reject { |u| index.archived?(u) }
    puts "#{urls.size} cited URLs, #{todo.size} to archive"
    todo.each_with_index do |url, i|
      entry = archiver.archive(url)
      index.save
      puts format("%3d/%d %-9s %s%s", i + 1, todo.size, entry["status"], url, entry["via"] ? " (wayback)" : "")
    end

    sources_dir = File.join(dir, "sources")
    FileUtils.mkdir_p(sources_dir)
    text_path = lambda do |url|
      e = index[url]
      return nil unless e && e["status"] == "ok" && e["cache_path"] && File.exist?(e["cache_path"])

      path = File.join(sources_dir, "#{ThisDay::Archive::Index.url_key(url)}.txt")
      unless File.exist?(path)
        text = e["cache_path"].end_with?(".pdf") ? ThisDay::Archive::Text.from_pdf(e["cache_path"]) : ThisDay::Archive::Text.from_html(File.read(e["cache_path"]))
        File.write(path, text.to_s)
      end
      path
    end

    brief = ["# Candidates for #{Date::MONTHNAMES[month]}: uncovered days", ""]
    days.each do |d|
      brief << "## #{Date::MONTHNAMES[month]} #{d['day']}" << ""
      d["candidates"].each_with_index do |c, i|
        brief << "### Candidate #{i + 1}: #{c['year']} (score #{c['score']})" << ""
        brief << "Wikipedia entry (#{c['page']}, revision #{c['revid']}; permalink #{c['permalink']}, " \
                 "archive: #{index[c['permalink']]&.fetch('status') || 'missing'}):" << ""
        brief << "> #{c['text'].gsub("\n", "\n> ")}" << ""
        c["refs"].each do |r|
          label = r["title"] || r["text"] || "(untitled citation)"
          if r["url"].to_s.start_with?("http")
            e = index[r["url"]]
            brief << "- Cited: #{label} (#{[r['author'], r['last'], r['work'], r['publisher'], r['date'], r['year'], r['page'] || r['pages']].compact.join(', ')})"
            brief << "  URL: #{r['url']} | archive: #{e&.fetch('status') || 'missing'}#{e&.dig('via') ? ' (Wayback copy)' : ''}" \
                     "#{e&.dig('title') ? " | page title: #{e['title']}" : ''}"
            path = text_path.call(r["url"])
            brief << "  Text: #{path}" if path
          else
            brief << "- Cited, no URL: #{label}"
          end
        end
        brief << ""
      end
    end
    File.write(File.join(dir, "brief.md"), brief.join("\n"))
    puts "Brief: #{File.join(dir, 'brief.md')}"
  end

  DRAFT_KEYS = %w[month day year title body photo_url photo_alt references status source_text
                  summarized_by summarized_at].sort.freeze
  BANNED_WORDS = /\b(richer|exactly|honest\w*|cleanly|spine|load[- ]bearing|settles|importantly)\b/i

  def draft_problems(event, index)
    problems = []
    problems << "keys: extra #{event.keys.sort - DRAFT_KEYS}, missing #{DRAFT_KEYS - event.keys.sort}" if event.keys.sort != DRAFT_KEYS
    plain = event["body"].to_s.gsub(/<[^>]+>/, " ").strip
    opening = "On #{Date::MONTHNAMES[event['month'].to_i]} #{event['day']}, #{event['year']}, "
    problems << "opening #{plain[0, 30].inspect}" unless plain.start_with?(opening)
    words = plain.split.size
    problems << "#{words} words" unless words.between?(80, 180)
    problems << "banned word #{plain[BANNED_WORDS]}" if plain.match?(BANNED_WORDS)
    problems << "status #{event['status']}" unless event["status"] == "draft"
    Array(event["references"]).each do |r|
      status = index[r["url"]]&.fetch("status")
      problems << "reference #{status || 'unarchived'}: #{r['url']}" unless status == "ok"
    end
    problems
  end

  desc "Check drafts against the style brief and the archive (FILE=tmp/provision-12/drafts.yaml)"
  task :check do
    require "yaml"
    require_relative "lib/this_day/archive/index"
    index = ThisDay::Archive::Index.new
    events = YAML.safe_load_file(ENV.fetch("FILE"), permitted_classes: [Date])
    failing = 0
    events.each do |e|
      problems = draft_problems(e, index)
      failing += 1 unless problems.empty?
      words = e["body"].to_s.gsub(/<[^>]+>/, " ").split.size
      puts format("%2d/%-2d/%d %3dw %d refs  %s", e["month"], e["day"], e["year"], words, Array(e["references"]).size, e["title"])
      problems.each { |p| puts "    ! #{p}" }
    end
    puts "#{events.size} drafts, #{failing} with problems"
  end

  # One block per event with JSON-quoted strings, the format the draft
  # files were generated in, so a replaced event is a small diff.
  def draft_block(e)
    q = ->(s) { s.nil? ? "null" : JSON.generate(s.to_s) }
    lines = ["- month: #{e['month']}", "  day: #{e['day']}", "  year: #{e['year']}",
             "  title: #{q.(e['title'])}", "  body: #{q.(e['body'])}",
             "  photo_url: #{q.(e['photo_url'])}", "  photo_alt: #{q.(e['photo_alt'])}", "  references:"]
    e["references"].each { |r| lines << "    - label: #{q.(r['label'])}" << "      url: #{q.(r['url'])}" }
    lines << "  status: #{q.(e['status'])}" << "  source_text: #{q.(e['source_text'])}"
    lines << "  summarized_by: #{q.(e['summarized_by'])}" << "  summarized_at: #{q.(e['summarized_at'])}"
    "#{lines.join("\n")}\n"
  end

  desc "Add or replace drafts in an event file, matched on month and day (FILE=drafts.yaml OUT=data/events/x.yaml)"
  task :add do
    require "yaml"
    require "json"
    incoming = YAML.safe_load_file(ENV.fetch("FILE"), permitted_classes: [Date])
    out = ENV.fetch("OUT")
    header = "# DRAFTS for human review -- every item below is status: draft and has not been checked by a person.\n" \
             "# Candidates from Wikipedia \"<year> in the Vietnam War\" pages (CC BY-SA 4.0); each body is written from the passages in source_text.\n"
    head, *blocks = File.exist?(out) ? File.read(out).split(/^(?=- month: )/) : [header]
    keyed = blocks.to_h { |b| [[b[/^- month: (\d+)/, 1].to_i, b[/^  day: (\d+)/, 1].to_i], b] }
    incoming.each { |e| keyed[[e["month"], e["day"]]] = draft_block(e) }
    File.write(out, head + keyed.sort.map(&:last).join)
    YAML.safe_load_file(out, permitted_classes: [Date])
    puts "#{out}: #{keyed.size} events (#{incoming.size} added or replaced)"
  end
end

namespace :deploy do
  desc "Build the deployment zip (bundle gems for Lambda via Docker, package app + db)"
  task :build do
    sh "rm -rf #{BUILD_DIR}"
    sh "mkdir -p #{BUILD_DIR}/db"
    sh "cp -r lib views app.rb config.ru Gemfile Gemfile.lock #{BUILD_DIR}/"
    sh "cp db/this_day.sqlite3 db/schema.sql #{BUILD_DIR}/db/"

    sha = `git rev-parse HEAD`.strip
    File.write("#{BUILD_DIR}/version.json", %({"sha":"#{sha}"}\n))

    puts "Bundling gems for x86_64-linux via Docker..."
    sh "docker run --rm --platform linux/amd64 " \
       "-v #{BUILD_DIR}:/var/task -w /var/task #{DOCKER_IMAGE} " \
       'bash -c "bundle config set --local path vendor/bundle && ' \
       "bundle config set --local without 'development test' && " \
       'bundle install"'

    sh "mkdir -p #{BUILD_DIR}/.bundle"
    File.write("#{BUILD_DIR}/.bundle/config", <<~YAML)
      ---
      BUNDLE_PATH: "vendor/bundle"
      BUNDLE_WITHOUT: "development:test"
    YAML

    puts "Creating zip..."
    sh "cd #{BUILD_DIR} && zip -r #{DEPLOY_ZIP} . -x '*.DS_Store'"
    puts "Built #{DEPLOY_ZIP}"
  end

  desc "Upload zip to S3 and update Lambda function code"
  task :push do
    sh "aws s3 cp #{DEPLOY_ZIP} s3://#{S3_BUCKET}/#{S3_KEY} --region #{AWS_REGION}"
    sh "aws lambda update-function-code " \
       "--function-name #{LAMBDA_FUNCTION} " \
       "--s3-bucket #{S3_BUCKET} --s3-key #{S3_KEY} " \
       "--region #{AWS_REGION}"
    puts "Waiting for Lambda update..."
    sh "aws lambda wait function-updated --function-name #{LAMBDA_FUNCTION} --region #{AWS_REGION}"
    puts "Lambda updated."
  end

  desc "Invalidate CloudFront cache"
  task :invalidate do
    sh "aws cloudfront create-invalidation " \
       "--distribution-id #{CF_DISTRIBUTION} " \
       "--paths '#{CF_INVALIDATION_PATH}'"
    puts "CloudFront invalidation submitted."
  end

  desc "Full deploy: build database, build zip, push to Lambda, invalidate CloudFront"
  task all: ["db:build", "deploy:build", "deploy:push", "deploy:invalidate"] do
    puts "Deploy complete."
  end
end

SERVER_PORT = 9301

desc "Start the local development server on port #{SERVER_PORT}"
task :server do
  sh "bundle exec rackup -p #{SERVER_PORT}"
end

SLIDES_SRC = File.expand_path("docs/slides/this-day-implementation.md", __dir__)
