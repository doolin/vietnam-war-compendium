<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals[:date_string] ? "This Day in Viet Nam — #{locals[:date_string]}" : "This Day in Viet Nam" %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: Georgia, "Times New Roman", serif;
      line-height: 1.6;
      color: #2c2c2c;
      background-color: #faf8f5;
      padding: 2rem 1rem;
    }

    main {
      max-width: 42rem;
      margin: 0 auto;
    }

    .day-nav {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.75rem;
      font-size: 0.9rem;
    }

    .day-nav a {
      color: #8b7355;
      text-decoration: none;
      padding: 0.25rem 0;
    }

    .day-nav a:hover {
      text-decoration: underline;
    }

    h1 {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
      color: #3a3a3a;
      border-bottom: 2px solid #8b7355;
      padding-bottom: 0.5rem;
    }

    .event-body {
      margin-bottom: 1.5rem;
    }

    .event-body p {
      margin-bottom: 1rem;
    }

    .event-photo {
      float: right;
      max-width: 280px;
      margin: 0 0 1rem 1.5rem;
    }

    .event-photo img {
      width: 100%;
      height: auto;
      display: block;
    }

    .event-photo figcaption {
      font-size: 0.85rem;
      color: #666;
      margin-top: 0.25rem;
    }

    .draft-notice {
      font-size: 0.85rem;
      color: #7a6200;
      background: #fff3c4;
      padding: 0.4rem 0.6rem;
      border-radius: 3px;
      margin-bottom: 1rem;
    }

    .credit {
      clear: both;
      font-size: 0.8rem;
      color: #888;
      text-align: right;
      font-style: italic;
    }

    .disclaimer {
      clear: both;
      border-top: 1px solid #ccc;
      margin-top: 1.5rem;
      padding-top: 0.75rem;
      font-size: 0.85rem;
      color: #8b2500;
      text-align: center;
    }

    .references {
      padding-top: 1rem;
      margin-top: 0.75rem;
    }

    .references h2 {
      font-size: 1rem;
      margin-bottom: 0.5rem;
      color: #555;
    }

    .references ol {
      padding-left: 1.25rem;
    }

    .references li {
      margin-bottom: 0.25rem;
    }

    .references a {
      color: #4a6fa5;
      text-decoration: none;
    }

    .references a:hover {
      text-decoration: underline;
    }

    .archive-status {
      font-size: 0.75rem;
      margin-left: 0.4rem;
      padding: 0 0.35rem;
      border-radius: 3px;
      white-space: nowrap;
    }

    .archive-status.archived { color: #3b6e3b; background: #e6f0e6; }
    .archive-status.unverified { color: #8b2500; background: #f5e6e0; }
    .snapshot { font-size: 0.75rem; margin-left: 0.3rem; white-space: nowrap; }

    .review-summary { color: #666; margin-bottom: 1.5rem; }

    .review-day { margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid #e0dcd5; }
    .review-day.empty h2 { color: #999; font-weight: normal; }
    .review-day h2 { font-size: 1.1rem; margin-bottom: 0.5rem; }
    .review-day h2 a { color: #3a3a3a; text-decoration: none; }

    .review-event { margin: 0 0 1rem 0; padding: 0.75rem; background: #fff; border-left: 3px solid #8b7355; }
    .review-event.status-draft { border-left-color: #c8a200; }
    .review-event.status-rejected { border-left-color: #b03030; opacity: 0.6; }
    .review-event h3 { font-size: 1rem; margin-bottom: 0.5rem; }
    .review-event .event-body { font-size: 0.95rem; }
    .review-refs { padding-left: 1.25rem; font-size: 0.9rem; }
    .review-refs a { color: #4a6fa5; text-decoration: none; }
    .source-text { margin: 0.5rem 0; font-size: 0.9rem; }
    .source-text summary { cursor: pointer; color: #8b7355; }
    .source-text blockquote { margin: 0.5rem 0 0 0; padding-left: 0.75rem; border-left: 2px solid #ccc; color: #555; white-space: pre-wrap; }
    .source-file { font-size: 0.75rem; color: #aaa; font-family: monospace; margin-top: 0.5rem; }

    .badge {
      display: inline-block;
      font-size: 0.7rem;
      font-family: sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.1rem 0.4rem;
      border-radius: 3px;
      margin-left: 0.4rem;
      vertical-align: middle;
    }
    .badge.approved { color: #3b6e3b; background: #e6f0e6; }
    .badge.draft { color: #7a6200; background: #fff3c4; }
    .badge.rejected { color: #8b2500; background: #f5e6e0; }
    .badge.missing { color: #999; background: #eee; }

    .fallback {
      text-align: center;
      padding: 3rem 1rem;
      color: #666;
    }

    .fallback p {
      font-size: 1.1rem;
    }

    #build-info {
      text-align: center;
      margin-top: 2rem;
      font-size: 0.75rem;
      color: #aaa;
      font-family: monospace;
    }

    @media (max-width: 480px) {
      h1 { font-size: 1.25rem; }

      .event-photo {
        float: none;
        max-width: 100%;
        margin: 0 0 1rem 0;
      }
    }
  </style>
</head>
<body>
  <main>
    <%= yield %>
    <footer id="build-info"><%= ThisDay::App.build_sha %></footer>
  </main>
  <script>
    // Left and right arrow keys follow the page's previous and next links.
    document.addEventListener("keydown", function (e) {
      if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      if (/^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || e.target.isContentEditable) return;
      var rel = { ArrowLeft: "prev", ArrowRight: "next" }[e.key];
      var link = rel && document.querySelector('.day-nav a[rel="' + rel + '"]');
      if (link) window.location.href = link.href;
    });
  </script>
</body>
</html>
