<nav class="day-nav">
  <a href="<%= date_path(prev_date) %>"><%= prev_date.strftime("%B %-d") %></a>
  <a href="<%= date_path(next_date) %>"><%= next_date.strftime("%B %-d") %></a>
</nav>

<h1>This Day in Viet Nam &mdash; <%= date_string %></h1>

<% if event.photo_url %>
<figure class="event-photo">
  <img src="<%= event.photo_url %>" alt="<%= event.photo_alt %>">
  <% if event.photo_alt %>
  <figcaption><%= event.photo_alt %></figcaption>
  <% end %>
</figure>
<% end %>

<% if event.draft? %>
<p class="draft-notice">Draft &mdash; this entry has not yet been reviewed.</p>
<% end %>

<article class="event-body">
  <%= event.body %>
</article>

<% if event.credit %>
<p class="credit"><%= event.credit %></p>
<% end %>

<p class="disclaimer">All material is for entertainment purposes only.</p>

<% unless event.references.empty? %>
<nav class="references" aria-label="References">
  <h2>References</h2>
  <ol>
    <% event.references.each do |ref| %>
    <li><a href="<%= ref.url %>" rel="noopener noreferrer"><%= ref.label %></a>
      <% if ref.archived? %>
      <span class="archive-status archived" title="A copy of this source was fetched and archived on <%= ref.archived_on %>">archived <%= ref.archived_on %></span>
      <% if ref.snapshot_url %>
      <a class="snapshot" href="<%= ref.snapshot_url %>" rel="noopener noreferrer" title="The cited address no longer serves this document; this is the Wayback Machine copy that was archived">Wayback copy</a>
      <% end %>
      <% else %>
      <span class="archive-status unverified" title="No archived copy of this source exists yet">unverified</span>
      <% end %>
    </li>
    <% end %>
  </ol>
</nav>
<% end %>
