<%# Previous/next links; the layout's script follows them on the left and right arrow keys. %>
<nav class="day-nav">
  <a href="<%= prev_href %>" rel="prev" aria-keyshortcuts="ArrowLeft">&larr; <%= prev_label %></a>
  <a href="<%= next_href %>" rel="next" aria-keyshortcuts="ArrowRight"><%= next_label %> &rarr;</a>
</nav>
